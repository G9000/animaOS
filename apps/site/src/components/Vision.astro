---
import AnimaCoreBoot from "./AnimaCoreBoot.tsx";
import CoreProperties from "./CoreProperties.tsx";
---

<section class="border-t px-8 md:px-16 lg:px-24 py-24 md:py-32" style="border-color: var(--accent)">

  <!-- First beat: centered pull-quote -->
  <div class="reveal max-w-2xl mx-auto text-center mb-20 md:mb-28">
    <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-foreground leading-[1.3] mb-8">
      The app's just chrome. The Core's the ghost in it.
    </h2>
    <p class="font-sans text-sm text-muted-foreground leading-relaxed max-w-lg mx-auto">
      The value was never the model. It was what she remembered. What she learned. What you
      built slowly, without really noticing — an engram that lives in one encrypted directory, no
      corpo server required. Copy it anywhere. Jack it in. It wakes up.
    </p>
  </div>

  <!-- Second beat: terminal + plain-text properties -->
  <div class="reveal grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
    <AnimaCoreBoot client:visible />
    <CoreProperties client:visible />
  </div>

</section>
