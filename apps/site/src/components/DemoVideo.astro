<section class="border-t px-8 md:px-16 lg:px-24 py-24 md:py-32" style="border-color: var(--accent)">

  <!-- First beat: centered caption -->
  <div class="reveal max-w-2xl mx-auto text-center mb-20 md:mb-28">
    <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-foreground leading-[1.3]">
      Copy the Core to a new machine. Watch it wake up with everything intact.
    </h2>
  </div>

  <!-- Second beat: full-width video -->
  <div class="reveal relative" style="border: 1px solid color-mix(in oklch, var(--accent) 35%, transparent)">
    <video src="/demo.mp4" autoplay muted loop playsinline class="w-full block" style="background: #000" />
  </div>

</section>
