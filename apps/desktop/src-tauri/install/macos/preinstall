#!/bin/sh
set -eu

matching_pids() {
  /bin/ps -axo pid=,comm= | /usr/bin/awk '$2 == "/Applications/ANIMA.app/Contents/MacOS/anima" || $2 == "/Applications/ANIMA.app/Contents/MacOS/desktop" {print $1}'
}

for pid in $(matching_pids); do
  /bin/kill -TERM "$pid" 2>/dev/null || true
done
attempt=0
while [ -n "$(matching_pids)" ]; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 50 ]; then
    echo "ANIMA is still running; refusing replacement installation" >&2
    exit 1
  fi
  /bin/sleep 0.1
done

if [ -e /Applications/ANIMA.app ] || [ -L /Applications/ANIMA.app ]; then
  /bin/rm -rf /Applications/ANIMA.app
fi
