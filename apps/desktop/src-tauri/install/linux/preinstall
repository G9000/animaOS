#!/bin/sh
set -eu

for process in /proc/[0-9]*/exe; do
  target=$(readlink "$process" 2>/dev/null || true)
  case "$target" in
    /usr/bin/anima|/usr/bin/desktop)
      pid=${process#/proc/}
      pid=${pid%/exe}
      kill -TERM "$pid" 2>/dev/null || true
      ;;
  esac
done

attempt=0
while :; do
  found=0
  for process in /proc/[0-9]*/exe; do
    target=$(readlink "$process" 2>/dev/null || true)
    case "$target" in /usr/bin/anima|/usr/bin/desktop) found=1 ;; esac
  done
  [ "$found" -eq 0 ] && break
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 50 ]; then
    echo "ANIMA is still running; refusing replacement installation" >&2
    exit 1
  fi
  sleep 0.1
done
