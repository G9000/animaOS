{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ANIMA",
  "mainBinaryName": "anima",
  "version": "0.1.0",
  "identifier": "com.leoca.anima",
  "build": {
    "beforeDevCommand": "vite --port 1420 --strictPort",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run prepare:release && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ANIMA",
        "width": 900,
        "height": 700,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; connect-src 'self' http://127.0.0.1:* http://localhost:* https://translate.googleapis.com; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/backgrounds/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "windows": {
      "wix": {
        "upgradeCode": "f0493d57-7a66-504b-ac04-60f1cb1cfb52",
        "fragmentPaths": ["install/windows/close-anima.wxs"],
        "componentRefs": ["AnimaUpgradeCloseGuard"]
      }
    },
    "resources": {
      "resources/runtime/": "runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
