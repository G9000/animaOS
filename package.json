{
  "name": "anima",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node ./scripts/dev-root.mjs",
    "dev:server": "node ./scripts/run-nx.cjs dev server",
    "dev:desktop": "node ./scripts/run-nx.cjs dev desktop",
    "dev:web": "cd apps/desktop && vite",
    "dev:anima-mod": "cd apps/anima-mod && bun run dev",
    "build": "node ./scripts/run-nx.cjs run-many -t build --projects=server,desktop && cargo check -p animus",
    "build:server": "node ./scripts/run-nx.cjs build server",
    "build:desktop": "node ./scripts/run-nx.cjs build desktop",
    "build:animus": "cargo check -p animus",
    "build:anima-mod": "cd apps/anima-mod && bun run build",
    "lint": "node ./scripts/run-nx.cjs run-many -t lint --projects=server,desktop",
    "lint:server": "node ./scripts/run-nx.cjs lint server",
    "lint:desktop": "node ./scripts/run-nx.cjs lint desktop",
    "test": "node ./scripts/run-uv.cjs run --project apps/server pytest",
    "test:server": "node ./scripts/run-uv.cjs run --project apps/server pytest",
    "test:desktop": "bun test apps/desktop/tests",
    "test:anima-mod": "cd apps/anima-mod && bun test",
    "start:anima-mod": "cd apps/anima-mod && bun run start",
    "dev:animus": "cargo run -p animus",
    "test:animus": "cargo test -p animus",
    "check:repo": "bun run scripts/check-repo-organization.ts",
    "python:sync": "uv sync --all-packages --all-extras",
    "python:lock": "uv lock",
    "db:server:revision": "node ./scripts/server-db-revision.cjs",
    "db:server:heads": "node ./scripts/run-nx.cjs run server:db-heads",
    "db:server:current": "node ./scripts/run-nx.cjs run server:db-current",
    "db:server:upgrade": "node ./scripts/run-nx.cjs run server:db-upgrade",
    "data:nuke": "bash ./scripts/nuke-dev-data.sh --yes",
    "data:nuke:reinit": "bash ./scripts/nuke-dev-data.sh --yes --migrate",
    "codegen:api-types": "bun run packages/api-client/scripts/generate-types.ts",
    "dev:site": "cd apps/site && bun run dev"
  },
  "devDependencies": {
    "nx": "^23.0.1",
    "typescript": "^6.0.3"
  }
}
